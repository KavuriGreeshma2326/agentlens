# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=agentlens
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=agentlens

# ─── Backend ─────────────────────────────────────────────────────────────────
# Used by FastAPI / Alembic (matches the docker-compose service name "db")
DATABASE_URL=postgresql://agentlens:change-me-before-use@db:5432/agentlens

# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL of the backend API — must be reachable from the browser (not the Docker network)
VITE_API_URL=http://localhost:8000
